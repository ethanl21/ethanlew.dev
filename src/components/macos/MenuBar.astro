---
import { MENU_LINKS } from "../../site";
---

<nav class="max-w-full overflow-x-auto bg-white" aria-label="Menu">
	<ul class="flex flex-row items-center gap-0 whitespace-nowrap">
		<li
			class="h-6 shrink-0 px-3.5 py-0.5 text-sm hover:bg-black hover:text-white"
			aria-hidden="true"
		>
			<!-- apple logo (decorative) -->
			<span class="align-text-bottom leading-none">
				<i class="icon-[fa7-brands--apple]" aria-hidden="true"></i>
			</span>
		</li>
		{
			MENU_LINKS.map((link) => (
				<li class="font-chicago h-6 shrink-0 px-2 py-1 text-sm leading-none text-black hover:bg-black hover:text-white">
					<span class="align-middle">{link.name}</span>
				</li>
			))
		}
	</ul>
</nav>
