---
const links = [
	{ name: "File", url: "#" },
	{ name: "Edit", url: "#" },
	{ name: "View", url: "#" },
	{ name: "Window", url: "#" },
	{ name: "Help", url: "#" },
];
---

<nav class="bg-white">
	<ul class="flex flex-row items-center gap-0">
		<li class="h-6 px-3.5 py-0.5 text-sm active:bg-black active:text-white">
			<!-- apple logo -->
			<button class="align-text-bottom leading-none">
				<i class="icon-[fa7-brands--apple]"></i>
			</button>
		</li>
		{
			links.map((link) => (
				<li class="font-chicago h-6 px-2 py-1 text-sm leading-none text-black active:bg-black active:text-white">
					<a class="align-middle" href={link.url}>
						{link.name}
					</a>
				</li>
			))
		}
	</ul>
</nav>
