---
import { MENU_LINKS } from "../../site";
---

<nav
	class="flex max-w-full flex-row items-center justify-between overflow-x-auto bg-white"
	aria-label="Menu"
>
	<ul class="flex min-w-0 flex-row items-center gap-0 whitespace-nowrap">
		<li
			class="h-6 shrink-0 px-3.5 py-0.5 text-sm hover:bg-black hover:text-white"
			aria-hidden="true"
		>
			<!-- apple logo (decorative) -->
			<span class="align-text-bottom leading-none">
				<i class="icon-[fa7-brands--apple]" aria-hidden="true"></i>
			</span>
		</li>
		<li
			class="font-chicago h-6 shrink-0 px-2 py-1 text-sm leading-none font-bold text-black"
			aria-current="page"
		>
			<span class="align-middle">Finder</span>
		</li>
		{
			MENU_LINKS.map((link) => (
				<li class="font-chicago h-6 shrink-0 px-2 py-1 text-sm leading-none text-black hover:bg-black hover:text-white">
					<span class="align-middle">{link.name}</span>
				</li>
			))
		}
	</ul>
	<span
		class="font-chicago hidden shrink-0 px-3 text-sm leading-none text-black sm:block"
		data-menubar-clock
		aria-hidden="true"
	>
		--:--
	</span>
</nav>

<script>
	function tickClock() {
		const el = document.querySelector("[data-menubar-clock]");
		if (!el) return;
		const now = new Date();
		let h = now.getHours() % 12;
		if (h === 0) h = 12;
		const m = String(now.getMinutes()).padStart(2, "0");
		el.textContent = `${h}:${m}`;
	}

	document.addEventListener("astro:page-load", () => {
		tickClock();
		const w = window as unknown as { __menubarClock?: number };
		if (w.__menubarClock) window.clearInterval(w.__menubarClock);
		w.__menubarClock = window.setInterval(tickClock, 30_000);
	});
</script>
