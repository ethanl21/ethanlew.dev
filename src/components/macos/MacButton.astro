---
interface Props {
	href?: string;
	id?: string;
	class?: string;
	target?: "_blank";
	rel?: string;
}

const { href, id, class: klass = "", target, rel } = Astro.props;
// One class string for every Mac-style button/link in the site.
const cls = `flex w-fit flex-row items-center gap-1 rounded border-[1.5px] border-black bg-white px-2.5 py-1 text-xl shadow-[2px_2px_0_#000] transition-transform focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0000aa] active:translate-x-0.5 active:translate-y-0.5 active:border-white active:bg-black active:text-white active:shadow-none disabled:opacity-50 sm:text-2xl ${klass}`;
---

{
	href ? (
		<a href={href} class={cls} target={target} rel={rel}>
			<slot />
		</a>
	) : (
		<button id={id} class={cls} type="button">
			<slot />
		</button>
	)
}
