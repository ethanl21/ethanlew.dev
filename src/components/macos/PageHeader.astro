---
import MacButton from "./MacButton.astro";

interface Props {
	title: string;
	backHref?: string;
	backLabel?: string;
}

const { title, backHref = "/", backLabel = "Back to Index Page" } = Astro.props;
---

<div class="flex flex-col gap-2">
	<h1 class="font-chicago text-3xl font-bold">{title}</h1>
	<MacButton href={backHref}>
		<i class="icon-[fa7-solid--arrow-left]" aria-hidden="true"></i>
		{backLabel}
	</MacButton>
</div>
