---
interface Props {
	title?: string;
}

const { title = "" } = Astro.props;
---

<div class="titlebar relative h-7 w-full border-b border-black">
	<!-- bg lines -->
	<div
		class="absolute top-0 left-0 flex h-full w-full flex-col justify-center gap-0.5 bg-white"
		aria-hidden="true"
	>
		<div class="w-full border-b border-black"></div>
		<div class="w-full border-b border-black"></div>
		<div class="w-full border-b border-black"></div>
		<div class="w-full border-b border-black"></div>
		<div class="w-full border-b border-black"></div>
		<div class="w-full border-b border-black"></div>
	</div>

	<div
		class="relative flex h-full w-full flex-row items-center justify-between px-4"
	>
		<!-- close btn -->
		<button
			class="block size-4 border border-black bg-white"
			aria-label="Close window"
			type="button"></button>

		<!-- window title -->
		<div
			class="inline-flex max-w-full items-center justify-start gap-2.5 bg-white px-2"
		>
			<div
				class="truncate text-center font-chicago text-xl leading-none font-medium text-black"
			>
				{title}
			</div>
		</div>

		<!-- maximize btn -->
		<button
			class="relative block size-4 shrink-0 border border-black bg-white"
			aria-label="Maximize window"
			type="button"
		>
			<div
				class="absolute top-0 left-0 h-2.5 w-2.5 border-r border-b border-black"
			>
			</div>
		</button>
	</div>
</div>
