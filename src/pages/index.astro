---
import MacDesktop from "../layouts/MacDesktop.astro";
import MacButton from "../components/macos/MacButton.astro";
---

<MacDesktop title="ethanlew.dev">
	<div class="flex flex-col p-4 sm:p-4">
		<div class="mb-8 flex h-full flex-grow flex-col gap-3 px-0 sm:px-4">
			<h1 class="text-5xl">
				<span class="font-lobster">Hello</span>, <span class="font-chicago"
					>I'm Ethan Lew!</span
				>
			</h1>
			<article class="prose prose-lg">
				<p>
					I'm a software developer with a B.S. Computer Science degree from Cal
					State Fullerton. I have experience with the following technologies:
				</p>

				<ul>
					<li>
						<i class="icon-[logos--html-5] mr-1 align-middle leading-none"
						></i>HTML, <i
							class="icon-[logos--css-3] mr-1 align-middle leading-none"
						></i>CSS,
						<i class="icon-[logos--javascript] mr-1 align-middle leading-none"
						></i>JavaScript, <i
							class="icon-[logos--typescript-icon] mr-1 align-middle leading-none"
						></i>TypeScript
					</li>
					<li>
						<i class="icon-[logos--react] mr-1 align-middle leading-none"
						></i>React,
						<i class="icon-[logos--nextjs-icon] mr-1 align-middle leading-none"
						></i>Next.js,
						<i class="icon-[logos--astro-icon] mr-1 align-middle leading-none"
						></i>Astro,
						<i class="icon-[logos--vitejs] mr-1 align-middle leading-none"
						></i>Vite
					</li>
					<li>
						<i class="icon-[logos--python] mr-1 align-middle leading-none"
						></i>Python,
						<i class="icon-[logos--rust] mr-1 align-middle leading-none"
						></i>Rust,
						<i class="icon-[logos--java] mr-1 align-middle leading-none"
						></i>Java,
						<i class="icon-[logos--c-sharp] mr-1 align-middle leading-none"
						></i>C#,
						<i class="icon-[logos--c-plusplus] mr-1 align-middle leading-none"
						></i>C++,
						<i class="icon-[logos--bash-icon] mr-1 align-middle leading-none"
						></i>Bash
					</li>
					<li>
						<i class="icon-[logos--git-icon] mr-1 align-middle leading-none"
						></i>Git,
						<i class="icon-[logos--docker-icon] mr-1 align-middle leading-none"
						></i>Docker / Docker Compose,
						<i class="icon-[fa7-brands--github] mr-1 align-middle leading-none"
						></i>GitHub Actions,
						<i
							class="icon-[logos--cloudflare-workers-icon] mr-1 align-middle leading-none"
						></i>Cloudflare Workers
					</li>
					<li>
						<i class="icon-[logos--unity] mr-1 align-middle leading-none"
						></i>Unity Engine,
						<i
							class="icon-[vscode-icons--file-type-meson] mr-1 align-middle leading-none"
						></i>Meson, REST APIs, Agile/Scrum
					</li>
				</ul>

				<p>For more information, click the buttons below.</p>

				<p>
					<strong>I'm currently seeking full-time employment!</strong> For more information,
					click the "Resumé" button below.
				</p>
			</article>
		</div>

		<div
			class="flex flex-row flex-wrap justify-center gap-4 rounded-md bg-neutral-400 px-2 py-4"
		>
			<MacButton href="/resume">
				<i class="icon-[fa7-solid--address-card]" aria-hidden="true"></i>Resumé
			</MacButton>
			<MacButton href="/contact">
				<i class="icon-[fa7-solid--envelope]" aria-hidden="true"></i>Contact
			</MacButton>
			<MacButton href="/projects">
				<i class="icon-[fa7-solid--brain]" aria-hidden="true"></i>Projects
			</MacButton>
			<MacButton href="/about-site">
				<i class="icon-[fa7-solid--circle-question]" aria-hidden="true"
				></i>About this site
			</MacButton>
		</div>
	</div>
</MacDesktop>
