---
import MacDesktop from "../layouts/MacDesktop.astro";
import PageHeader from "../components/macos/PageHeader.astro";
import { GITHUB_URL } from "../site";
---

<MacDesktop title="Projects">
	<div class="flex h-full max-h-full flex-col gap-2 p-4 sm:p-8">
		<PageHeader title="Projects" />

		<article class="prose max-w-full">
			<ul>
				<li>
					ethanlew.dev
					<ul>
						<li>
							Built using <i
								class="icon-[logos--astro-icon] mr-1 align-middle leading-none"
								aria-hidden="true"></i>{Astro.generator}
						</li>
						<li>
							Styled with <i
								class="icon-[logos--tailwindcss-icon] mr-1 align-middle leading-none"
								aria-hidden="true"></i>TailwindCSS and a UI kit from <i
								class="icon-[logos--figma]"
								aria-hidden="true"></i> Figma
						</li>
					</ul>
				</li>
				<li>
					psvm
					<ul>
						<li>Pokémon Showdown's battle simulator as a C++ library</li>
						<li>
							Bundled with <i
								class="icon-[logos--esbuild] mr-1 align-middle leading-none"
								aria-hidden="true"></i>esbuild, built using <i
								class="icon-[vscode-icons--file-type-meson] mr-1 align-middle leading-none"
								aria-hidden="true"></i>Meson
						</li>
					</ul>
				</li>
				<li>
					CalSafe
					<ul>
						<li>
							<i
								class="icon-[logos--nextjs-icon] mr-1 align-middle leading-none"
								aria-hidden="true"
							>
							</i>Next.js web app that plots Southern California vehicle
							collision data on a map, including accidents and AI-powered
							accident predictions
						</li>
						<li>
							Styled with <i
								class="icon-[logos--tailwindcss-icon] mr-1 align-middle leading-none"
								aria-hidden="true"></i>TailwindCSS and shadcn/ui
						</li>
						<li>
							Hosted by <i class="icon-[logos--vercel-icon]" aria-hidden="true"
							></i> Vercel and <i
								class="icon-[logos--heroku-icon]"
								aria-hidden="true"></i> Heroku
						</li>
					</ul>
				</li>
				<li>
					CovidMap
					<ul>
						<li>
							Plots graphs and diagrams of COVID-19 metrics sourced from
							multiple REST APIs
						</li>
						<li>
							<i
								class="icon-[logos--react] mr-1 align-middle leading-none"
								aria-hidden="true"></i>React app built with <i
								class="icon-[logos--vitejs] mr-1 align-middle leading-none"
								aria-hidden="true"></i>Vite
						</li>
					</ul>
				</li>
				<li>
					RetroRatings
					<ul class="list-disc-inside ml-8">
						<li>
							<i
								class="icon-[logos--react] mr-1 align-middle leading-none"
								aria-hidden="true"></i>React app used to rate items similar to
							Yelp
						</li>
						<li>
							Uses <i
								class="icon-[logos--firebase] mr-1 align-middle leading-none"
								aria-hidden="true"></i>
							Firebase + Cloud Firestore
						</li>
					</ul>
				</li>
				<li>
					ScribbleBounce
					<ul>
						<li>
							<i
								class="icon-[logos--unity] mr-1 align-middle leading-none"
								aria-hidden="true"></i>Unity game
						</li>
						<li>
							Puzzle game where the player must draw lines to bounce a ball into
							a goal
						</li>
					</ul>
				</li>
			</ul>

			<p>
				For more information, please visit my{" "}
				<a
					class="underline"
					href={GITHUB_URL}
					target="_blank"
					rel="noopener noreferrer">GitHub</a
				>
				page.
			</p>
		</article>
	</div>
</MacDesktop>
