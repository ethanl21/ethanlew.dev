			<p class="text-center text-2xl">
				For all inquiries, please send an email to:<br />

				<strong>hi</strong> (at) <strong>ethanlew</strong> (dot)
				<strong>dev</strong>
				<br />
				<i class="icon-[fa7-solid--envelope-open-text]" aria-hidden="true"></i>
				<i class="icon-[fa7-solid--heart]" aria-hidden="true"></i>
			</p>
		</article>
	</div>
</Layout>
