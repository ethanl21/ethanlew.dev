---
import Layout from "../layouts/MacDesktop.astro";
---

<>
	<Layout title="Resumé">
		<div class="flex flex-col gap-4 p-8">
			<div class="flex flex-col gap-2">
				<h1 class="font-chicago text-3xl font-bold">Resumé</h1>
				<a
					class="flex w-fit flex-row items-center gap-1 rounded-md border-2 border-black bg-white px-1.5 py-1 text-2xl active:border-white active:bg-black active:text-white disabled:opacity-50"
					href="/"
				>
					<i class="icon-[fa7-solid--arrow-left]"></i>
					Back to Index Page
				</a>
			</div>
			<article class="prose">
				<div class="flex flex-col items-center gap-4">
					<div class="not-prose relative w-fit rounded-md border-2">
						<iframe
							title="Resumé"
							class="w-10/12 min-w-lg md:h-96"
							src="https://docs.google.com/document/d/e/2PACX-1vTq7PnwKAnm7SwzU6jvEqLkiCG9AvwbbisuVCuflLBvhLz7_aQKwUEgqypmnbwzl7qeYLmg6P6FeUqx/pub?embedded=true"
						></iframe>
					</div>

					<div class="not-prose flex flex-row justify-center gap-4">
						<a
							href="https://drive.google.com/file/d/1UnzLa1QXqxL_RCRCOSA0OtZpnqF3MZAM/view?usp=sharing"
							class="flex w-fit flex-row items-center gap-1 rounded-md border-2 border-black bg-white px-1.5 py-1 text-2xl active:border-white active:bg-black active:text-white disabled:opacity-50"
							target="_blank"
							rel="noopener noreferrer"
						>
							<span class="icon-[fa7-solid--file-download]"></span>
							Download
						</a>
						<button
							class="flex w-fit flex-row items-center gap-1 rounded-md border-2 border-black bg-white px-1.5 py-1 text-2xl active:border-white active:bg-black active:text-white disabled:opacity-50"
							id="resume-expand-btn"
						>
							<span class="icon-[fa7-solid--expand-arrows-alt]"></span>
							Expand
						</button>
					</div>
				</div>
			</article>
		</div>

		<dialog
			id="resume-expand-dlg"
			class="mx-auto mt-4 h-full w-full rounded-sm bg-white p-4 md:w-1/2"
		>
			<iframe
				title="Resumé"
				class="h-full w-full"
				src="https://docs.google.com/document/d/e/2PACX-1vTq7PnwKAnm7SwzU6jvEqLkiCG9AvwbbisuVCuflLBvhLz7_aQKwUEgqypmnbwzl7qeYLmg6P6FeUqx/pub?embedded=true"
			></iframe>
			<button
				class="absolute top-2 right-2 rounded-md border-2 border-black bg-white px-1.5 py-1 text-2xl leading-none active:border-white active:bg-black active:text-white disabled:opacity-50"
				onclick="document.getElementById('resume-expand-dlg').close()"
			>
				<i class="icon-[fa7-solid--xmark]"></i>
			</button>
		</dialog>
	</Layout>
</>

<style>
	@media (max-width: 768px) {
		dialog#resume-expand-dlg {
			width: 90%;
		}
	}
</style>

<script>
	const expandBtn = document.getElementById("resume-expand-btn");
	const dlg = document.getElementById("resume-expand-dlg");

	if (expandBtn && dlg) {
		expandBtn.addEventListener("click", () => {
			(dlg as HTMLDialogElement).showModal();
		});

		document.body.append(dlg);
	}
</script>
