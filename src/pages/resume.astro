---
import Layout from "../layouts/MacDesktop.astro";
import MacButton from "../components/macos/MacButton.astro";
import PageHeader from "../components/macos/PageHeader.astro";
import { RESUME_EMBED_URL, RESUME_EDIT_URL } from "../site";
---

<Layout title="Resumé">
	<div class="flex flex-col gap-4 p-4 sm:p-8">
		<PageHeader title="Resumé" />
		<article class="prose max-w-full">
			<div class="flex flex-col items-center gap-4">
				<div class="not-prose w-full rounded-md border-2">
					<iframe
						title="Resumé"
						class="h-64 w-full sm:h-96"
						src={RESUME_EMBED_URL}
						loading="lazy"></iframe>
				</div>

				<div class="not-prose flex flex-row flex-wrap justify-center gap-4">
					<MacButton
						href={RESUME_EDIT_URL}
						target="_blank"
						rel="noopener noreferrer"
					>
						<span class="icon-[fa7-solid--file-download]" aria-hidden="true"
						></span>
						Download
					</MacButton>
					<MacButton id="resume-expand-btn">
						<span class="icon-[fa7-solid--expand-arrows-alt]" aria-hidden="true"
						></span>
						Expand
					</MacButton>
				</div>
			</div>
		</article>
	</div>

	<dialog
		id="resume-expand-dlg"
		class="mx-auto mt-4 h-full max-h-[90vh] w-[90%] rounded-sm bg-white p-4 md:w-1/2"
	>
		<iframe
			title="Resumé"
			class="h-full w-full"
			src={RESUME_EMBED_URL}
			loading="lazy"></iframe>
		<button
			class="absolute top-2 right-2 rounded-md border-2 border-black bg-white px-1.5 py-1 text-2xl leading-none active:border-white active:bg-black active:text-white disabled:opacity-50"
			id="resume-close-btn"
			type="button"
			aria-label="Close expanded resumé"
		>
			<i class="icon-[fa7-solid--xmark]" aria-hidden="true"></i>
		</button>
	</dialog>
</Layout>

<script>
	let onExpand: (() => void) | null = null;
	let onClose: (() => void) | null = null;

	function setupResumeDialog() {
		teardownResumeDialog();
		const expandBtn = document.getElementById("resume-expand-btn");
		const closeBtn = document.getElementById("resume-close-btn");
		const dlg = document.getElementById(
			"resume-expand-dlg",
		) as HTMLDialogElement | null;
		if (!expandBtn || !dlg) return;

		// Keep dialog at body level so showModal isn't clipped by window overflow.
		if (dlg.parentElement !== document.body) document.body.append(dlg);

		onExpand = () => dlg.showModal();
		onClose = () => dlg.close();
		expandBtn.addEventListener("click", onExpand);
		closeBtn?.addEventListener("click", onClose);
	}

	function teardownResumeDialog() {
		const expandBtn = document.getElementById("resume-expand-btn");
		const closeBtn = document.getElementById("resume-close-btn");
		if (expandBtn && onExpand) expandBtn.removeEventListener("click", onExpand);
		if (closeBtn && onClose) closeBtn.removeEventListener("click", onClose);
		onExpand = onClose = null;
	}

	document.addEventListener("astro:page-load", setupResumeDialog);
	document.addEventListener("astro:before-swap", teardownResumeDialog);
</script>
