---
import { Image } from "astro:assets";
import MenuBar from "../components/macos/MenuBar.astro";
import systemFloppy from "./_assets/System Floppy.svg";
import trash from "./_assets/Trash.svg";
import Window from "../components/macos/Window.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.tailwind.css";

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
		<link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin />

		<script
			is:inline
			data-goatcounter="https://ethanlewdotdev.goatcounter.com/count"
			async
			src="//gc.zgo.at/count.js"></script>

		<slot name="head" />

		<ClientRouter />
	</head>
	<body class="font-mac">
		<div class="relative flex h-dvh flex-col overflow-hidden">
			<header
				class="sticky top-0 left-0 z-10 h-fit w-full border-b border-solid border-black"
			>
				<MenuBar />
			</header>
			<main
				class="desktop-pattern relative flex w-full flex-1 min-h-0 flex-col items-center overflow-hidden bg-neutral-200 p-4 sm:p-8"
			>
				<!-- desktop icons -->
				<div class="absolute top-7 right-0 hidden sm:block" aria-hidden="true">
					<Image src={systemFloppy} alt="" loading="eager" />
				</div>

				<div
					class="absolute right-3 bottom-3 hidden sm:block"
					aria-hidden="true"
				>
					<Image src={trash} alt="" loading="eager" />
				</div>

				<!-- window: sole scroll container lives inside Window (.scrollbar).
				     flex-1 gives this wrapper a definite height so the
				     max-h-full chain below resolves the same in every engine. -->
				<div
					class="flex max-h-full min-h-0 w-full max-w-4xl min-w-0 flex-1 flex-col justify-center py-6 lg:w-auto"
					data-draggable
				>
					<Window title={title}>
						<slot />
					</Window>
				</div>
			</main>
		</div>

		<script>
			import { Draggable } from "@neodrag/vanilla";

			let draggable: Draggable | null = null;

			function setupDraggable() {
				teardownDraggable();
				const el = document.querySelector<HTMLElement>("[data-draggable]");
				// Dragging only makes sense with a fine pointer + room to move.
				if (
					el &&
					window.matchMedia("(pointer: fine)").matches &&
					window.matchMedia("(min-width: 1024px)").matches
				) {
					draggable = new Draggable(el, { axis: "both", handle: ".titlebar" });
				} else if (el) {
					el.style.transform = "";
				}
			}

			function teardownDraggable() {
				draggable?.destroy();
				draggable = null;
			}

			document.addEventListener("astro:page-load", setupDraggable);
			document.addEventListener("astro:before-swap", teardownDraggable);
		</script>
	</body>
</html>

<style>
	:root {
		@apply overscroll-none;
	}
</style>
